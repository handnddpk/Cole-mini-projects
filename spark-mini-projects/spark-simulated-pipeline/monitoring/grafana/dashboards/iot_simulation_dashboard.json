        {
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT \n  device_id as \"Device ID\",\n  device_type as \"Type\",\n  location as \"Location\",\n  AVG(battery_level) as \"Battery Level\",\n  AVG(signal_strength) as \"Signal Strength\",\n  COUNT(*) as \"Readings (24h)\",\n  MAX(timestamp) as \"Last Reading\"\nFROM sensor_readings sr\nJOIN device_metadata dm ON sr.device_id = dm.device_id\nWHERE sr.timestamp >= NOW() - INTERVAL '24 hours'\nGROUP BY sr.device_id, dm.device_type, dm.location\nORDER BY \"Battery Level\" ASC\nLIMIT 20",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "device_id"
                ],
                "type": "column"
              }
            ]
          ],
          "table": "sensor_readings",
          "timeColumn": "timestamp",
          "timeColumnType": "timestamp",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
      ],
