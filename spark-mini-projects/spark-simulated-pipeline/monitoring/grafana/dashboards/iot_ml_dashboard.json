        {
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT \n  mp.device_id as \"Device ID\",\n  dm.device_type as \"Type\",\n  dm.location as \"Location\",\n  mp.predicted_value as \"Risk Score\",\n  mp.confidence as \"Confidence\",\n  mp.timestamp as \"Prediction Time\"\nFROM ml_predictions mp\nJOIN device_metadata dm ON mp.device_id = dm.device_id\nWHERE mp.timestamp >= NOW() - INTERVAL '24 hours'\nAND mp.prediction_type = 'failure_risk'\nAND mp.predicted_value > 0.5\nORDER BY mp.predicted_value DESC\nLIMIT 20",
          "refId": "A"
        }
