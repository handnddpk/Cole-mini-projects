# Spark Configuration
SPARK_MASTER_URL=spark://localhost:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=realdata_warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=spark-realdata-consumer

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# API Keys (Replace with actual keys)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
NEWS_API_KEY=your_news_api_key
WEATHER_API_KEY=your_weather_api_key

# Data Lake Configuration
DATA_LAKE_PATH=/opt/bitnami/spark/data
BRONZE_LAYER_PATH=/opt/bitnami/spark/data/bronze
SILVER_LAYER_PATH=/opt/bitnami/spark/data/silver
GOLD_LAYER_PATH=/opt/bitnami/spark/data/gold

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin
ENABLE_METRICS=true
