# External API Configuration
# Copy this file to .env and add your API keys

# Financial Data APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
YAHOO_FINANCE_API_KEY=your_yahoo_finance_key_here
POLYGON_API_KEY=your_polygon_key_here

# Social Media APIs
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Weather APIs
OPENWEATHER_API_KEY=your_openweather_key_here
WEATHER_GOV_API_KEY=your_weather_gov_key_here

# E-commerce APIs
SHOPIFY_API_KEY=your_shopify_key_here
SHOPIFY_PASSWORD=your_shopify_password_here
WOOCOMMERCE_KEY=your_woocommerce_key_here
WOOCOMMERCE_SECRET=your_woocommerce_secret_here

# Database Configuration
POSTGRES_DB=spark_realtime
POSTGRES_USER=spark_user
POSTGRES_PASSWORD=spark_password
REDIS_PASSWORD=redis_password

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# MinIO Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=admin123
PROMETHEUS_CONFIG_PATH=./monitoring/prometheus.yml

# ML Model Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_REGISTRY_URI=http://localhost:5000

# Spark Configuration
SPARK_MASTER_URL=spark://localhost:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=2

# API Rate Limits
API_RATE_LIMIT_PER_MINUTE=100
MAX_CONCURRENT_REQUESTS=10

# Data Retention
DATA_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
