# Environment Configuration for Kafka Multi-Source Real-Time Integration Pipeline

# ===========================================
# API Keys and Credentials
# ===========================================

# Financial Data API (Alpha Vantage)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FINANCIAL_DATA_SYMBOLS=AAPL,GOOGL,MSFT,TSLA,AMZN
FINANCIAL_DATA_INTERVAL=1min

# Social Media API (Twitter API v2)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_HASHTAGS=#kafka,#bigdata,#realtime,#streaming

# Weather Data API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_CITIES=London,NewYork,Tokyo,Sydney,Mumbai
WEATHER_UPDATE_INTERVAL=300

# E-commerce API (Demo/Mock API)
ECOMMERCE_API_URL=https://api.demo-ecommerce.com
ECOMMERCE_API_KEY=your_ecommerce_api_key_here

# ===========================================
# Database Configurations
# ===========================================

# Source MySQL Database (for CDC)
MYSQL_SOURCE_HOST=mysql-source
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_DATABASE=ecommerce
MYSQL_SOURCE_USER=debezium
MYSQL_SOURCE_PASSWORD=dbz
MYSQL_ROOT_PASSWORD=rootpassword

# Source PostgreSQL Database (for CDC)
POSTGRES_SOURCE_HOST=postgres-source
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_DATABASE=inventory
POSTGRES_SOURCE_USER=postgres
POSTGRES_SOURCE_PASSWORD=postgres

# MongoDB Source (for CDC)
MONGODB_SOURCE_HOST=mongodb-source
MONGODB_SOURCE_PORT=27017
MONGODB_SOURCE_DATABASE=userprofiles
MONGODB_SOURCE_USER=debezium
MONGODB_SOURCE_PASSWORD=dbz

# ===========================================
# Target System Configurations
# ===========================================

# ClickHouse Configuration
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=kafka_connect
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# S3/MinIO Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=kafka-connect-data
MINIO_ENDPOINT=http://minio:9000

# ===========================================
# Kafka Connect Configuration
# ===========================================

# Connect Cluster Configuration
CONNECT_BOOTSTRAP_SERVERS=kafka:29092
CONNECT_REST_PORT=8083
CONNECT_GROUP_ID=kafka-connect-cluster
CONNECT_CONFIG_STORAGE_TOPIC=connect-configs
CONNECT_OFFSET_STORAGE_TOPIC=connect-offsets
CONNECT_STATUS_STORAGE_TOPIC=connect-status

# Schema Registry Configuration
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Connect Plugin Path
CONNECT_PLUGIN_PATH=/usr/share/java,/usr/share/confluent-hub-components

# ===========================================
# Data Generation Configuration
# ===========================================

# Event Generation Rates (events per minute)
ORDER_GENERATION_RATE=500
PRODUCT_UPDATE_RATE=100
CUSTOMER_EVENT_RATE=200
INVENTORY_UPDATE_RATE=150

# Data Quality Configuration
ENABLE_DATA_VALIDATION=true
SCHEMA_VALIDATION_STRICT=false
ENABLE_DUPLICATE_DETECTION=true

# ===========================================
# Monitoring Configuration
# ===========================================

# Prometheus Configuration
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# JMX Metrics Configuration
KAFKA_JMX_PORT=9101
CONNECT_JMX_PORT=9102
SCHEMA_REGISTRY_JMX_PORT=9103

# ===========================================
# Performance Tuning
# ===========================================

# Kafka Connect Worker Configuration
CONNECT_TASKS_MAX=8
CONNECT_CONSUMER_MAX_POLL_RECORDS=500
CONNECT_PRODUCER_BATCH_SIZE=16384
CONNECT_PRODUCER_LINGER_MS=5

# Consumer Configuration
CONSUMER_MAX_POLL_RECORDS=1000
CONSUMER_FETCH_MIN_BYTES=1024
CONSUMER_FETCH_MAX_WAIT_MS=500

# Producer Configuration
PRODUCER_BATCH_SIZE=32768
PRODUCER_LINGER_MS=10
PRODUCER_COMPRESSION_TYPE=snappy
PRODUCER_BUFFER_MEMORY=134217728

# ===========================================
# Security Configuration
# ===========================================

# SSL Configuration (optional)
KAFKA_SSL_ENABLED=false
KAFKA_SSL_KEYSTORE_LOCATION=/etc/ssl/kafka.keystore.jks
KAFKA_SSL_KEYSTORE_PASSWORD=changeit
KAFKA_SSL_TRUSTSTORE_LOCATION=/etc/ssl/kafka.truststore.jks
KAFKA_SSL_TRUSTSTORE_PASSWORD=changeit

# SASL Configuration (optional)
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=kafka
KAFKA_SASL_PASSWORD=kafka-secret

# ===========================================
# Development Configuration
# ===========================================

# Debug and Logging
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGGING=false
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824

# Development Mode Settings
DEVELOPMENT_MODE=true
AUTO_CREATE_TOPICS=true
SCHEMA_REGISTRY_DEBUG=false

# ===========================================
# Resource Limits
# ===========================================

# Memory Configuration (MB)
KAFKA_HEAP_OPTS=-Xmx2G -Xms2G
CONNECT_HEAP_OPTS=-Xmx1G -Xms1G
SCHEMA_REGISTRY_HEAP_OPTS=-Xmx512M -Xms512M

# Container Resource Limits
KAFKA_MEMORY_LIMIT=4g
CONNECT_MEMORY_LIMIT=2g
ELASTICSEARCH_MEMORY_LIMIT=2g
CLICKHOUSE_MEMORY_LIMIT=2g

# ===========================================
# Feature Flags
# ===========================================

# Enable/Disable Components
ENABLE_FINANCIAL_CONNECTOR=true
ENABLE_SOCIAL_CONNECTOR=true
ENABLE_WEATHER_CONNECTOR=true
ENABLE_CDC_CONNECTORS=true
ENABLE_ELASTICSEARCH_SINK=true
ENABLE_CLICKHOUSE_SINK=true
ENABLE_REDIS_SINK=true
ENABLE_S3_SINK=true

# Advanced Features
ENABLE_SCHEMA_EVOLUTION=true
ENABLE_EXACTLY_ONCE_SEMANTICS=false
ENABLE_TRANSACTIONS=false
ENABLE_IDEMPOTENT_PRODUCER=true
